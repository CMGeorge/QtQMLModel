{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Windows (CI-like)",
			"type": "shell",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"scripts/build_windows_ci.ps1",
				"-QtVersion",
				"6.7.2",
				"-Config",
				"Debug"
			],
			"isBackground": false,
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build"
		},
		{
			"label": "Build Windows (CI-like)",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"scripts/build_windows_ci.ps1",
				"-QtVersion",
				"6.7.2",
				"-Config",
				"Debug"
			],
			"isBackground": false,
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build"
		}
	]
}